{
  "name": "apisix_api",
  "description": "APISIX API 插件",
  "version": "1.0.0",
  "author": "baiuu",
  "config": [
    {
      "name": "admin_key",
      "type": "string",
      "description": "AdminKey",
      "required": true
    },
    {
      "name": "server_address",
      "type": "string",
      "description": "服务地址",
      "required": true
    }
  ],
  "actions": [
    {
      "name": "upload_bind",
      "description": "上传绑定",
      "params": [
        {
          "name": "domain",
          "type": "array",
          "description": "域名列表",
          "required": true
        },
        {
          "name": "ocsp_stapling",
          "type": "string",
          "description": "OCSP Stapling 插件参数（JSON 字符串），例如 {\"enabled\":true,\"skip_verify\":false,\"cache_ttl\":3600}",
          "required": false
        },
        {
          "name": "extra",
          "type": "string",
          "description": "其他 ssls 字段（JSON 字符串），原样合并进请求体，例如 {\"type\":\"server\",\"status\":1,\"ssl_protocols\":[\"TLSv1.2\",\"TLSv1.3\"],\"labels\":{\"env\":\"production\"}}",
          "required": false
        }
      ]
    }
  ]
}
